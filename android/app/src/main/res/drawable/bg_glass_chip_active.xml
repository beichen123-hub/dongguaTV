<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃选中态（暖橙光晕 + 亮边框） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#CCFF8E68"
                android:endColor="#80FF6B3D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:top="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp"
        android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#55FF6B3D"
                android:endColor="#33FF6B3D" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
