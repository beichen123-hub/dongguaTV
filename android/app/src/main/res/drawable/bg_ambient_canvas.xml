<?xml version="1.0" encoding="utf-8"?>
<!-- 全局深空环境光底色：顶部微弱暖橙与冷蓝氛围光，衬托液态玻璃通透感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorBackground" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.18"
                android:centerY="0.06"
                android:startColor="#26FF6B3D"
                android:endColor="#000B0D13" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:centerX="0.88"
                android:centerY="0.16"
                android:startColor="#203B82F6"
                android:endColor="#000B0D13" />
        </shape>
    </item>
</layer-list>
