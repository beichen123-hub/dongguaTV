<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃圆形图标底（悬浮返回键等） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#55FFFFFF"
                android:endColor="#18FFFFFF" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#A6141824" />
        </shape>
    </item>
</layer-list>
