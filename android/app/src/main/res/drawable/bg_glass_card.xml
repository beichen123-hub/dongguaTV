<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃卡片：半透明渐变基底 + 1dp 玻璃高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#30FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#1FFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#C41E2332"
                android:endColor="#B812151E" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
