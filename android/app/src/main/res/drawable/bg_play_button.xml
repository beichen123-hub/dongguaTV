<?xml version="1.0" encoding="utf-8"?>
<!-- 主播放按钮：暖橙珊瑚斜向渐变 + 玻璃微高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#88FFFFFF"
                android:endColor="#22FF6B3D" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FF7E4F"
                android:endColor="#E94E24" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
